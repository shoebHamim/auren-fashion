# Copy to .env (gitignored). Values below match docker-compose.yml for local development.

# --- Database (PLAN §8, §22.2): app role = DML only; migrator role = DDL
DATABASE_URL=postgres://auren_app:auren_app@localhost:5433/auren
DATABASE_MIGRATOR_URL=postgres://auren_migrator:auren_migrator@localhost:5433/auren

# --- API
API_PORT=4000
# Public origin of the site; the API trusts only this origin for mutations (PLAN §10.2)
WEB_ORIGIN=http://localhost:3100
LOG_LEVEL=debug

# --- Web (server-side calls go straight to the API over the internal network)
API_INTERNAL_URL=http://localhost:4000

# --- Object storage (used from Phase 2). Local: SeaweedFS. Production: Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=auren
S3_SECRET_ACCESS_KEY=auren-dev-secret
S3_PUBLIC_BUCKET=auren-public-media
S3_PRIVATE_BUCKET=auren-private-docs
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/auren-public-media

# --- Email (used from Phase 1). Local: Mailpit (UI at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Auren <no-reply@auren.local>"
