# Production settings for infra/deploy/compose.yml. Copy to infra/deploy/.env on the VPS (never commit it).
# Generate secrets with: openssl rand -base64 32 | tr -d '=+/'

# Site
SITE_ADDRESS=auren.example            # bare domain or www.… (served behind the Cloudflare proxy)
WEB_ORIGIN=https://auren.example      # must match the public origin exactly
TLS_MODE=origin                       # origin = Cloudflare origin cert in ./certs; off = plain HTTP (local checks only)
LOG_LEVEL=info
AUREN_VERSION=latest

# Database (Postgres runs on this VPS; no public port)
POSTGRES_PASSWORD=change-me
AUREN_MIGRATOR_DB_PASSWORD=change-me
AUREN_APP_DB_PASSWORD=change-me

# Optional port overrides (local verification only)
# HTTP_PORT=8080
# HTTPS_PORT=8443
