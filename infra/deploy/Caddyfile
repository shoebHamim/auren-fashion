# Edge for the single-VPS deployment (PLAN §25.2.1): TLS, path routing, internal routes blocked.
{
	servers {
		# Only Cloudflare may set the client IP (CF-Connecting-IP). Source: cloudflare.com/ips (2026-10-03).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# TLS_MODE=origin → Cloudflare origin certificate ("Full (strict)"); TLS_MODE=off → plain HTTP (local checks).
(tls_origin) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
}
(tls_off) {
}

{$SITE_ADDRESS} {
	import tls_{$TLS_MODE}
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	# Signed revalidation endpoint is for the worker only, over the internal network (PLAN §4.7).
	@internal path /_internal/*
	respond @internal 404

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
